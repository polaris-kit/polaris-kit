{
  "name": "@polaris-kit/themes",
  "version": "1.0.0",
  "description": "Theme engine and light/dark themes for Polaris UI, mapping design tokens to CSS variables.",
  "keywords": [
    "css-variables",
    "design-system",
    "polaris-ui",
    "themes",
    "theming",
    "ui"
  ],
  "homepage": "https://main--6a6a03885409ae6257b04aac.chromatic.com",
  "bugs": {
    "url": "https://github.com/polaris-kit/polaris-kit/issues"
  },
  "license": "MIT",
  "author": "Mateus Neiva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polaris-kit/polaris-kit.git",
    "directory": "packages/themes"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@polaris-kit/tokens": "workspace:*"
  },
  "devDependencies": {
    "react": "19.2.7",
    "tsup": "8.0.0",
    "typescript": "6.0.3"
  }
}
